# NewBoy server — environment template.
# Local dev: copy to `.env`. On a host: set these as real environment variables.
# `.env` itself is gitignored — never commit the real token.

# ── core ─────────────────────────────────────────────────────
# Owner password for the "owner lock" (unlock via POST /v1/auth/unlock).
# Required, >= 8 characters. Unset = fail-closed: every write API returns 401.
OWNER_TOKEN=change-me-to-a-long-secret

# MongoDB connection string. Defaults to a local, auth-less instance.
#MONGODB_URI=mongodb://127.0.0.1:27017

# HTTP port. Default 3031.
#PORT=3031

# Comma-separated browser origins allowed to call the API.
# Production fails closed when this is unset. Local development defaults to :3030.
#CORS_ORIGINS=https://your-frontend.example.com

# ── market (quotes, all via CoinGecko) ───────────────────────
# Egress proxy for quote fetches. Empty = direct connection.
#MARKET_PROXY_URL=http://127.0.0.1:7897
# Poll interval in ms. Default 300000 (5 min).
#MARKET_POLL_MS=300000

# ── news (CoinDesk / Cointelegraph RSS + 深潮) ───────────────
# Egress proxy for the two RSS feeds. Empty = direct. The application currently
# defaults to the local development proxy, so production hosts should set this empty.
#NEWS_PROXY_URL=http://127.0.0.1:7897
# Refresh schedule (cron). Default every 4 hours.
#NEWS_CRON=0 */4 * * *
# Optional AI curation. Without keys, raw headlines are served as-is.
#SILICON_API_KEY=
#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com
#NEWS_AI_MODEL=deepseek-chat

# ── files ────────────────────────────────────────────────────
# Trash auto-purge schedule. Default daily at 04:23.
#FILES_TRASH_CRON=23 4 * * *
# Days before a trashed item is purged. Default 7.
#FILES_TRASH_DAYS=7

# ── hotaru (image/video processing) ─────────────────────────
# Python interpreter. Defaults to server/.venv (npm run python:setup), then python3.
#HOTARU_PYTHON=
# Job retention in ms. Default 30 min.
#HOTARU_JOB_TTL_MS=1800000

# ── lab (laser cards; needs Blender) ─────────────────────────
# Blender binary. Defaults to a Homebrew path, then `blender` on PATH.
#LAB_BLENDER=
# Python interpreter for the texture step. Defaults to server/.venv, then python3.
#LAB_PYTHON=
# Queue cap. Default 2.
#LAB_QUEUE_LIMIT=2
# Job retention in ms. Default 30 min.
#LAB_JOB_TTL_MS=1800000
